<Window x:Class="ChildGTS_Group02.AdminWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Admin Dashboard" Height="600" Width="1000" WindowStartupLocation="CenterScreen" Loaded="AdminWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Admin Dashboard" FontSize="36" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,20,0,20" Grid.Row="0"/>

        <!-- Dashboard Metrics -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Total Users -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="20" Grid.Column="0">
                <TextBlock Text="Total Users:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="TotalUsersTextBlock" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Total Children -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="20" Grid.Column="2">
                <TextBlock Text="Total Children:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="TotalChildrenTextBlock" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Total Revenue -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="20" Grid.Column="4">
                <TextBlock Text="Total Revenue:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="TotalRevenueTextBlock" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Search and DataGrid -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Search Section -->
            <!-- Search TextBox and Button -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Doctor's List -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search -->
                </Grid.ColumnDefinitions>

                <!-- Doctor's List Label -->
                <TextBlock Text="Doctor's List:" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,10,0"/>

                <!-- Search TextBox and Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                    <TextBox Name="SearchTextBox" Width="300" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Search by Full Name, Email, or Phone"/>
                    <Button x:Name="SearchButton" Content="Search" Width="120" Height="30" Click="SearchButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- DataGrid for Users with RoleId = 2 -->
            <DataGrid Name="UsersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Doctor Code" Binding="{Binding DoctorCode}" Width="100"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position.PositionName}" Width="150" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="130"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Buttons -->
            <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button x:Name="CreateButton" Content="Create Doctor" Width="200" Height="60" FontSize="16" Margin="0,10,0,10" Click="CreateDoctorButton_Click"/>
                <Button x:Name="UpdateButton" Content="Update Doctor" Width="200" Height="60" FontSize="16" Margin="0,10,0,10" Click="UpdateDoctorButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete Doctor" Width="200" Height="60" FontSize="16" Margin="0,10,0,10" Click="DeleteDoctorButton_Click"/>
            </StackPanel>
        </Grid>
        <Label x:Name="HelloMessageLabel" Content="Hello " HorizontalAlignment="Left" Margin="549,24,0,0" VerticalAlignment="Top" Height="48" Width="230" FontSize="20" RenderTransformOrigin="0.62,0.571"/>
        <Button x:Name="LogoutButton" Content="Log out" HorizontalAlignment="Left" Margin="811,0,0,0" VerticalAlignment="Center" Height="56" Width="169" FontSize="16" Background="#FFE30404" Foreground="#FFF3F3F3" Click="LogoutButton_Click"/>
    </Grid>
</Window>



