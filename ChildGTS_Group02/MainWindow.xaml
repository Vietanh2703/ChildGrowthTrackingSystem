<Window x:Class="ChildGTS_Group02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="Child Growth Tracking System" Height="600" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <!-- App Name Label -->
        <TextBlock Text="Child Growth Tracking System"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="20,20,0,0"
                   Name="AppNameLabel"/>

        <!-- Login Button -->
        <Button Content="Login"
                FontSize="16"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Name="LoginButton" Click="LoginPageButton_Click"/>

        <!-- Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="20,80,20,80"
                      Name="ContentScrollViewer">
            <StackPanel Name="MainContentPanel">
                <!-- System Information -->
                <TextBlock Text="System Information"
           FontSize="18"
           FontWeight="Bold"
           Margin="0,20,0,10"/>
                <TextBlock Text="This system is designed to help track the growth and health of children. It provides tools for parents, doctors, and administrators to manage and monitor child growth records, health alerts, and more."
           TextWrapping="Wrap"
           Margin="0,0,0,20"/>
                <TextBlock Text="Features:"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• Track child growth records" />
                    <LineBreak />
                    <Run Text="• Manage health alerts" />
                    <LineBreak />
                    <Run Text="• Share data with doctors" />
                    <LineBreak />
                    <Run Text="• Access blogs and resources" />
                </TextBlock>
                <!-- Blog Boxes -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 1: Tips for Child Growth"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox1Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox1DetailButton"/>
                    </Grid>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 2: Healthy Nutrition for Kids"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox2Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox2DetailButton"/>
                    </Grid>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 3: Importance of Regular Checkups"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox3Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox3DetailButton"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FAQ Button -->
        <Button Content="FAQ"
                Width="100"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Name="FAQButton"
                Click="FAQButton_Click"/>
    </Grid>
</Window>
