<Window x:Class="ChildGTS_Group02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="Child Growth Tracking System" Height="600" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <!-- App Name Label -->
        <TextBlock Text="Child Growth Tracking System"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="20,20,0,0"
                   Name="AppNameLabel"/>

        <!-- Login Button -->
        <Button Content="Login"
                FontSize="16"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Name="LoginButton" Click="LoginPageButton_Click"/>

        <!-- Information Boxes with ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="20,100,20,20"
                      Name="BlogScrollViewer">
            <StackPanel Orientation="Vertical"
                        Name="InfoBoxPanel">
                <!-- Blog Box 1 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 1: Tips for Child Growth"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox1Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox1DetailButton"/>
                    </Grid>
                </Border>
                <!-- Blog Box 2 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 2: Healthy Nutrition for Kids"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox2Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox2DetailButton"/>
                    </Grid>
                </Border>
                <!-- Blog Box 3 -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20" Margin="10" Height="150" Width="800">
                    <Grid>
                        <TextBlock Text="Blog Post 3: Importance of Regular Checkups"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Name="BlogBox3Text"/>
                        <Button Content="View Detail"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Name="BlogBox3DetailButton"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
