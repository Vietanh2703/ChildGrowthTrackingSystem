<Window x:Class="ChildGTS_Group02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Child Growth Tracking System" Height="600" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="BlogMainWindow_Loaded">
    <Grid>
        <!-- App Name Label -->
        <TextBlock Text="Child Growth Tracking System"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="20,20,0,0"
                   Name="AppNameLabel"/>

        <!-- Login Button -->
        <Button Content="Login"
                FontSize="16"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Name="LoginButton" Click="LoginPageButton_Click"/>

        <Button Content="Become Our Member"
        FontSize="16"
        Width="180"
        Height="40"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,20,190,0"
        Name="BecomeMemberButton" Click="BecomeMemberButton_Click" RenderTransformOrigin="0.129,0.734"/>


        <!-- Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="20,80,20,80"
                      Name="ContentScrollViewer">
            <StackPanel Name="MainContentPanel">
                <!-- System Information -->
                <TextBlock Text="System Information"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,20,0,10"/>
                <TextBlock Text="This system is designed to help track the growth and health of children. It provides tools for parents, doctors, and administrators to manage and monitor child growth records, health alerts, and more."
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>
                <TextBlock Text="Features:"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• Track child growth records" />
                    <LineBreak />
                    <Run Text="• Manage health alerts" />
                    <LineBreak />
                    <Run Text="• Share data with doctors" />
                    <LineBreak />
                    <Run Text="• Access blogs and resources" />
                </TextBlock>

                <!-- Blog DataGrid -->
                <DataGrid Name="BlogDataGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          Margin="0,0,0,20"
          Height="300"
          MouseDoubleClick="BlogDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                        <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat=\{0:MM/dd/yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="Author" Binding="{Binding Author.FullName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- FAQ Button -->
        <Button Content="FAQ"
                Width="100"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Name="FAQButton"
                Click="FAQButton_Click"/>
    </Grid>
</Window>
