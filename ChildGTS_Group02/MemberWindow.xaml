<Window x:Class="ChildGTS_Group02.MemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="MemberWindow" Height="600" Width="900" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <!-- Danh sách feedback của bác sĩ -->
        <DataGrid x:Name="dgDoctorFeedbacks"
                  AutoGenerateColumns="False"
                  Margin="10"
                  Grid.Row="0"
                  SelectionMode="Single"
                  SelectionChanged="dgDoctorFeedbacks_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Feedback ID" Binding="{Binding FeedbackId}" Width="*"/>
                <DataGridTextColumn Header="Ngày phản hồi" Binding="{Binding FeedbackDate}" Width="*"/>
                <DataGridTextColumn Header="Comments" Binding="{Binding Comments}" Width="2*"/>
                <DataGridTextColumn Header="Recommendations" Binding="{Binding Recommendations}" Width="2*"/>
                <DataGridTextColumn Header="FollowUpDate" Binding="{Binding FollowUpDate}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*"/>
                <DataGridTextColumn Header="ParentAcknowledged" Binding="{Binding ParentAcknowledged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Form đánh giá feedback -->
        <Border Grid.Row="1" Margin="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="10">
                <TextBlock Text="Đánh giá phản hồi của bác sĩ" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Điểm đánh giá (1-5):" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbRating" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Nhận xét thêm:" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbRatingComment" Width="400"/>
                </StackPanel>
                <Button Content="Gửi đánh giá" Width="150" Margin="0,10,0,0" HorizontalAlignment="Left" Click="BtnSubmitRating_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
