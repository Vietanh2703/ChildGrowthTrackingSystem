<Window x:Class="ChildGTS_Group02.MemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="MemberWindow" Height="450" Width="1000" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid x:Name="ChildrenDataGrid" AutoGenerateColumns="False" Margin="10,10,10,60">
            <DataGrid.Columns>
                <!-- Columns remain unchanged -->
                <DataGridTextColumn Header="Child's Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth}" Width="*"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="*"/>
                <DataGridTextColumn Header="Birth Weight (kg)" Binding="{Binding BirthWeight}" Width="*"/>
                <DataGridTextColumn Header="Birth Height (cm)" Binding="{Binding BirthHeight}" Width="*"/>
                <DataGridTextColumn Header="Profile Image" Binding="{Binding ProfileImage}" Width="*"/>
                <DataGridTextColumn Header="Profile Created Date" Binding="{Binding CreatedDate}" Width="*"/>
                <DataGridTextColumn Header="Last Checkup Date" Binding="{Binding LastCheckupDate}" Width="*"/>
                <DataGridTextColumn Header="Medical Notes" Binding="{Binding MedicalNotes}" Width="*"/>
                <DataGridTextColumn Header="Parent's Name" Binding="{Binding Parent.FullName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Group of buttons at the bottom of the same row -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Content="Add Child" x:Name="CreateBtn" Width="120" Height="40" Margin="10,0" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderBrush="#388E3C" 
                    BorderThickness="1" Click="CreateBtn_Click"/>
            <Button Content="Update and View Details" x:Name="UpdateBtn" Width="160" Height="40" Margin="10,0" 
                    Background="#2196F3" Foreground="White" FontWeight="Bold" BorderBrush="#1976D2" 
                    BorderThickness="1" Click="UpdateBtn_Click"/>
            <Button Content="Delete Child" x:Name="DeleteBtn" Width="120" Height="40" Margin="10,0" 
                    Background="#F44336" Foreground="White" FontWeight="Bold" BorderBrush="#D32F2F" 
                    BorderThickness="1" Click="DeleteBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>
