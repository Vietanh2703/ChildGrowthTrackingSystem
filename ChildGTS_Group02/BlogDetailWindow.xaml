<Window x:Class="ChildGTS_Group02.BlogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blog Detail" Height="400" Width="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBlock Text="Blog Detail"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"/>

        <StackPanel Margin="20,80,20,20">
            <TextBlock Text="Title:" FontWeight="Bold"/>
            <TextBlock Name="TitleTextBlock" Margin="0,0,0,10"/>

            <TextBlock Text="Category:" FontWeight="Bold"/>
            <TextBlock Name="CategoryTextBlock" Margin="0,0,0,10"/>

            <TextBlock Text="Author:" FontWeight="Bold"/>
            <TextBlock Name="AuthorTextBlock" Margin="0,0,0,10"/>

            <TextBlock Text="Content:" FontWeight="Bold"/>
            <TextBlock Name="ContentTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Window>
