<Window x:Class="ChildGTS_Group02.CreditCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credit Card Information" Height="230" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid Margin="10,20,0,9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Serial Number -->
        <TextBlock Text="Serial Number:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Name="SerialNumberTextBox" Grid.Row="0" Margin="150,0,0,5" HorizontalAlignment="Left" Width="200" TextChanged="SerialNumberTextBox_TextChanged"/>

        <TextBlock Text="Cardholder Name:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Name="CardholderTextBox" Grid.Row="1" Margin="150,0,0,5" HorizontalAlignment="Left" Width="200" TextChanged="CardholderTextBox_TextChanged" PreviewTextInput="CardholderTextBox_PreviewTextInput"/>

        <!-- Expired Date -->
        <TextBlock Text="Expiration Date (MM/YY):" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Name="ExpirationDateTextBox" Grid.Row="2" Margin="150,0,0,5" HorizontalAlignment="Left" Width="200" PreviewTextInput="ExpirationDateTextBox_PreviewTextInput" LostFocus="ExpirationDateTextBox_LostFocus"/>

        <!-- CVV -->
        <TextBlock Text="CVV:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Name="CVVTextBox" Grid.Row="3" Margin="150,0,0,5" HorizontalAlignment="Left" Width="200" PreviewTextInput="CVVTextBox_PreviewTextInput" TextChanged="CVVTextBox_TextChanged"/>

        <Button Content="Purchase" Grid.Row="4" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" Click="PurchaseButton_Click"/>
    </Grid>
</Window>
