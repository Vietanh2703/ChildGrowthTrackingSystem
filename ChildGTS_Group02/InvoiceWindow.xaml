<Window x:Class="ChildGTS_Group02.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice" Height="600" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Invoice Details -->
        <StackPanel>
            <TextBlock Text="Invoice Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Invoice ID:" FontWeight="Bold"/>
            <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Margin="0,5,0,5"/>
            <TextBlock Text="Transaction ID:" FontWeight="Bold"/>
            <TextBlock Text="{Binding TransactionId}" Margin="0,5,0,15"/>
            <TextBlock Text="Transaction Date:" FontWeight="Bold"/>
            <TextBlock Text="{Binding TransactionDate}" Margin="0,5,0,15"/>
            <TextBlock Text="User Full Name:" FontWeight="Bold"/>
            <TextBlock Text="{Binding UserFullName}" Margin="0,5,0,15"/>
            <TextBlock Text="Package Name:" FontWeight="Bold"/>
            <TextBlock Text="{Binding PackageName}" Margin="0,5,0,15"/>
            <TextBlock Text="Package Description:" FontWeight="Bold"/>
            <TextBlock Text="{Binding PackageDescription}" Margin="0,5,0,15"/>
            <TextBlock Text="Amount:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Amount}" Margin="0,5,0,15"/>
            <TextBlock Text="Payment Method:" FontWeight="Bold"/>
            <TextBlock Text="{Binding PaymentMethod}" Margin="0,5,0,15"/>
            <TextBlock Text="Status:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Status}" Margin="0,5,0,15"/>
        </StackPanel>

        <!-- Close Button -->
        <Button Content="Close" Width="100" Height="30" HorizontalAlignment="Center" Grid.Row="1" Margin="0,20,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
