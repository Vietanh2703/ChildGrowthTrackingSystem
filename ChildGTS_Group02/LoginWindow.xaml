<Window x:Class="ChildGTS_Group02.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Welcome back" Foreground="#FF02723D" HorizontalAlignment="Center" Height="60" Margin="0,30,0,0" VerticalAlignment="Top" FontWeight="ExtraBold" FontSize="30" />

        <Label Content="Username" Foreground="#FF00AC5B" HorizontalAlignment="Left" Margin="50,100,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="15" />
        <TextBox x:Name="EmailTextBox" Margin="50,130,50,0" VerticalAlignment="Top" Height="30" FontSize="14" BorderBrush="#97E6C1" VerticalContentAlignment="Center" Foreground="#FF00B460" />

        <Label Content="Password" Foreground="#FF00B25F" HorizontalAlignment="Left" Margin="50,180,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="15" />
        <StackPanel Margin="50,210,50,0" VerticalAlignment="Top">
            <PasswordBox x:Name="PasswordHiddenBox" Height="30" FontSize="14"   BorderBrush="#97E6C1" Foreground="#FF35B723" />
            <TextBox x:Name="PasswordShowBox" Height="30" FontSize="14"   BorderBrush="#97E6C1" Visibility="Collapsed" VerticalContentAlignment="Center" Foreground="#FF25CC23" />
            <CheckBox x:Name="CheckBoxHide" Content="Show Password" Foreground="#02BE68" Margin="0,10,0,0" Checked="CheckBoxHide_Checked" Unchecked="CheckBoxHide_Unchecked" />
        </StackPanel>

        <Button x:Name="LoginButton" Content="Log in" Margin="50,300,50,0" VerticalAlignment="Top" Height="40" Background="#02BE68" Foreground="White" FontSize="16" FontWeight="Bold" Click="LoginButton_Click" />

        <Button x:Name="QuitButton" Content="Back" Margin="50,360,50,0" VerticalAlignment="Top" Height="40" Background="#BE0202" Foreground="White" FontSize="16" FontWeight="Bold" Click="QuitButton_Click" />
    </Grid>
</Window>
