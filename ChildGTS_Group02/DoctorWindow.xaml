<Window x:Class="ChildGTS_Group02.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="DoctorWindow" Height="828" Width="1000" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="37*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Danh sách GrowthRecord -->
        <DataGrid x:Name="dgGrowthRecords"
                  AutoGenerateColumns="False"
                  Margin="10,10,10,10"
                  Grid.Row="0"
                  SelectionMode="Single"
                  SelectionChanged="dgGrowthRecords_SelectionChanged" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" Width="*"/>
                <DataGridTextColumn Header="Child ID" Binding="{Binding ChildId}" Width="*"/>
                <DataGridTextColumn Header="Tên trẻ" Binding="{Binding ChildName}" Width="*"/>
                <DataGridTextColumn Header="Ngày ghi nhận" Binding="{Binding RecordDate}" Width="*"/>
                <DataGridTextColumn Header="Chiều cao (cm)" Binding="{Binding Height}" Width="*"/>
                <DataGridTextColumn Header="Cân nặng (kg)" Binding="{Binding Weight}" Width="*"/>
                <DataGridTextColumn Header="Vòng đầu (cm)" Binding="{Binding HeadCircumference}" Width="*"/>
                <DataGridTextColumn Header="BMI" Binding="{Binding BMI}" Width="*"/>
                <DataGridTextColumn Header="Loại đo" Binding="{Binding MeasurementType}" Width="*"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Form nhập feedback cho bản ghi được chọn -->
        <Border Grid.Row="1" Margin="10,10,10,10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Grid.ColumnSpan="2">
            <StackPanel Margin="10">
                <TextBlock Text="Feedback cho bản ghi đã chọn" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Comments:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbComments" Width="400"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Recommendations:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbRecommendations" Width="400"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="FollowUpDate:" Width="120" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpFollowUpDate" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Status:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbStatus" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Attachments:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbAttachments" Width="300"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Priority:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbPriority" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="ParentAcknowledged:" Width="120" VerticalAlignment="Center"/>
                    <CheckBox x:Name="cbParentAcknowledged"/>
                </StackPanel>
                <Button Content="Gửi Feedback" Width="150" Margin="0,10,0,0" HorizontalAlignment="Left" Click="BtnSubmitFeedback_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
