<Window x:Class="ChildGTS_Group02.MembershipRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Membership Register" Height="650" Width="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Define two rows: one for the TextBlock and one for the ScrollViewer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TextBlock -->
            <RowDefinition Height="*"/>
            <!-- ScrollViewer -->
        </Grid.RowDefinitions>

        <!-- Static TextBlock in the first row -->
        <TextBlock Text="Membership Registration"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,20"
                   Grid.Row="0"/>

        <!-- Scrollable content in the second row -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
            <StackPanel Margin="20,20,20,20">
                <!-- Email -->
                <TextBlock Text="Email:" FontWeight="Bold"/>
                <TextBox Name="EmailTextBox" Margin="0,0,0,10" LostFocus="EmailTextBox_LostFocus"/>
                <TextBlock Name="EmailErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Password -->
                <TextBlock Text="Password:" FontWeight="Bold"/>
                <PasswordBox Name="PasswordBox" Margin="0,0,0,10" LostFocus="PasswordBox_LostFocus" Visibility="Visible"/>
                <TextBox Name="PasswordTextBox" Margin="0,0,0,10" Visibility="Collapsed" Text="{Binding Text, ElementName=PasswordBox, Mode=TwoWay}"/>
                <TextBlock Name="PasswordErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password:" FontWeight="Bold"/>
                <PasswordBox Name="ConfirmPasswordBox" Margin="0,0,0,10" LostFocus="ConfirmPasswordBox_LostFocus" Visibility="Visible"/>
                <TextBox Name="ConfirmPasswordTextBox" Margin="0,0,0,10" Visibility="Collapsed" Text="{Binding Text, ElementName=ConfirmPasswordBox, Mode=TwoWay}"/>
                <TextBlock Name="ConfirmPasswordErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Show Password Checkbox -->
                <CheckBox Content="Show Password" Margin="0,0,0,10" Checked="ShowPassword_Checked" Unchecked="ShowPassword_Unchecked"/>

                <!-- Full Name -->
                <TextBlock Text="Full Name:" FontWeight="Bold"/>
                <TextBox Name="FullNameTextBox" Margin="0,0,0,10" LostFocus="FullNameTextBox_LostFocus"/>
                <TextBlock Name="FullNameErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Phone -->
                <TextBlock Text="Phone:" FontWeight="Bold"/>
                <TextBox Name="PhoneTextBox" Margin="0,0,0,10" LostFocus="PhoneTextBox_LostFocus"/>
                <TextBlock Name="PhoneErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Address -->
                <TextBlock Text="Address:" FontWeight="Bold"/>
                <TextBox Name="AddressTextBox" Margin="0,0,0,10" LostFocus="AddressTextBox_LostFocus"/>
                <TextBlock Name="AddressErrorTextBlock" Foreground="Red" Visibility="Collapsed"/>

                <!-- Membership Packages -->
                <TextBlock Text="Membership Packages:" FontWeight="Bold" Margin="0,20,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Name="Package1Border"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="10"
                            Width="200"
                            Height="100"
                            Background="White"
                            MouseLeftButtonDown="Package1Border_MouseLeftButtonDown">
                        <TextBlock Name="Package1TextBlock" TextWrapping="Wrap"/>
                    </Border>
                    <Border Name="Package2Border"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="10"
                            Width="200"
                            Height="100"
                            Background="White"
                            MouseLeftButtonDown="Package2Border_MouseLeftButtonDown">
                        <TextBlock Name="Package2TextBlock" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Register Button -->
                <Button x:Name="RegisterButton" Content="Register"
                        Width="100"
                        Height="30"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Click="RegisterButton_Click"
                        IsEnabled="{Binding IsFormValid}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
