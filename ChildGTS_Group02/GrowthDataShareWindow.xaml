<Window x:Class="ChildGTS_Group02.GrowthDataShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="GrowthDataShareWindow" Height="572" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Width="500">

                <!-- Growth Record Section -->
                <TextBlock Text="Growth Record" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Height (cm)" />
                <TextBox x:Name="HeightBox" />

                <TextBlock Text="Weight (kg)" Margin="0,5,0,0"/>
                <TextBox x:Name="WeightBox" />

                <TextBlock Text="Head Circumference (cm)" Margin="0,5,0,0"/>
                <TextBox x:Name="HeadBox" />

                <TextBlock Text="BMI" Margin="0,5,0,0"/>
                <TextBox x:Name="BmiBox" />

                <TextBlock Text="Measurement Type" Margin="0,5,0,0"/>
                <TextBox x:Name="MeasurementTypeBox" />

                <TextBlock Text="Notes" Margin="0,5,0,0"/>
                <TextBox x:Name="NoteBox" Height="60"/>
 

                <!-- Spacer -->
                <Rectangle Height="20" Fill="Transparent"/>

                <!-- Data Share Section (Simplified) -->

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Recorded By"
               VerticalAlignment="Center"
               FontWeight="SemiBold"
               Width="100"/>
                    <ComboBox x:Name="DoctorNameComboBox"
          Width="200"
          DisplayMemberPath="FullName"
          SelectedValuePath="UserId"
          Margin="5"/>

                </StackPanel>

                <!-- Save/Cancel Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Save" Click="SaveBtn_Click" Width="100" Background="Green" Foreground="White" Padding="10,5"/>
                    <Button Content="Cancel" Click="CancelBtn_Click" Width="100" Background="Gray" Foreground="White" Padding="10,5" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
