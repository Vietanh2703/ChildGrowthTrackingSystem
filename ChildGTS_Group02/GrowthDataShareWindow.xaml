<Window x:Class="ChildGTS_Group02.GrowthDataShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChildGTS_Group02"
        mc:Ignorable="d"
        Title="GrowthDataShareWindow" Height="572" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="GrowthDataWindow_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Width="500" >

                <TextBlock Text="Child Name" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ChildNameBox" IsReadOnly="True" Background="#F0F0F0"  />

                <TextBlock Text="Growth Record" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
                <TextBlock Text="Height (cm)" />
                <TextBox x:Name="HeightBox" />
                <TextBlock Text="Weight (kg)" Margin="0,5,0,0"/>
                <TextBox x:Name="WeightBox" />
                <TextBlock Text="Head Circumference (cm)" Margin="0,5,0,0"/>
                <TextBox x:Name="HeadBox" />
                <TextBlock Text="Measurement Type" Margin="0,5,0,0"/>
                <TextBox x:Name="MeasurementTypeBox" />
                <TextBlock Text="Notes" Margin="0,5,0,0"/>
                <TextBox x:Name="NoteBox" Height="60"/>
                <TextBlock Text="Record by" Margin="0,5,0,0"/>
                <TextBox x:Name="RecordByBox" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,400,0,0">

                <Button Content="Save" Click="SaveBtn_Click" Width="120" Background="#4CAF50" Foreground="White" Padding="1,5" FontWeight="Bold" ToolTip="Save the growth record" Height="52"/>

                <Button Content="Cancel" Click="CancelBtn_Click" Width="108" Background="#F44336" Foreground="White" Padding="10,5" Margin="10,0,0,0" FontWeight="Bold" ToolTip="Cancel and close the window" Height="54"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
